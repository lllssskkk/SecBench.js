#!groovy

// Load shared pipeline library
@Library('velox') _

properties([
    // Only keep Jenkins builds around for 14 days
    // Note that this is independent of the related artifacts stored in Artifactory
    buildDiscarder(logRotator(artifactDaysToKeepStr: '', artifactNumToKeepStr: '', daysToKeepStr: '14', numToKeepStr: '')),
])

veloxPipeline { p ->
    
    stage('node 8') {
        p.useNode('8')
        sh '''
            git clean -fxd
            npm install --prefer-offline
            npm test
        '''
    }

    stage('node 10') {
        p.useNode('10')
        sh '''
            git clean -fxd
            npm install --prefer-offline
            npm test
        '''
    }

}
